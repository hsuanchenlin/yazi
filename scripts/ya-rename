#!/bin/sh
# Wrapper for Yazi's ai-rename plugin: holds the multi-word prompt and prints
# only the first non-empty filename, so yazi.toml can name a single absolute
# binary.
#
#   [plugin]
#   ai_rename_cmd = "/Users/you/.local/bin/ya-rename"
#
# Standalone, pass a basename. When Yazi runs this as ai_rename_cmd, it appends
# its own rename prompt as the argument; either form is forwarded as argv.
#
# YA_RENAME_CLI  - executable name or path (default: claude)
# YA_RENAME_ARGS - extra CLI flags, word-split (default: --print)

set -eu
set -f

cli=${YA_RENAME_CLI:-claude}
instruction='Suggest a clearer filename for the file named in the next argument. Keep its extension. Reply with the new filename alone: one line, no directory, no quotes, no explanation.'

if [ "$#" -ne 1 ]; then
	printf 'ya-rename: usage: ya-rename <filename>\n' >&2
	exit 2
fi

resolved=
case $cli in
	*/*) resolved=$cli ;;
	*) resolved=$(command -v "$cli" 2>/dev/null) || resolved= ;;
esac
if [ -z "$resolved" ] || [ ! -f "$resolved" ] || [ ! -x "$resolved" ]; then
	printf 'ya-rename: CLI not found or not executable: %s\n' "$cli" >&2
	exit 127
fi

if [ "${YA_RENAME_ARGS+set}" = set ]; then
	output=$("$resolved" $YA_RENAME_ARGS "$instruction" "$1") || exit $?
else
	output=$("$resolved" --print "$instruction" "$1") || exit $?
fi

name=$(printf '%s\n' "$output" | sed -n '/[^[:space:]]/{s/^[[:space:]]*//;s/[[:space:]]*$//;p;q;}')
if [ -z "$name" ]; then
	printf 'ya-rename: CLI printed no filename\n' >&2
	exit 1
fi
printf '%s\n' "$name"
